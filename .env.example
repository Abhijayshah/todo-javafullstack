# -----------------------------------------------------------------------------
# Full-Stack Todo Application Environment Configuration Template
# Copy this file to .env and adjust variables as needed for production.
# -----------------------------------------------------------------------------

# PostgreSQL Database Configuration
POSTGRES_DB=tododb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Spring Boot Backend Configuration
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tododb

# Security & JSON Web Token (JWT)
# IMPORTANT: Generate a secure 256-bit or 512-bit random hex/base64 key for production!
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# React Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
